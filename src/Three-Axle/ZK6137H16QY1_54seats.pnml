}

switch (FEAT_ROADVEHS, SELF, switch_ZK6137H16QY1_54seats_graphics, position_in_articulated_veh) {
    0: switch_ZK6137H16QY1_54seats_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6137H16QY1_54seats_articulated_part, extra_callback_info1) {
