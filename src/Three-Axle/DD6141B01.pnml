// Begin DD6141B01

spriteset (spriteset_DD6141B01_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Three-Axle", "DD6141B01_SHIJIAZHUANG")
}

spriteset (spriteset_DD6141B01_shijiazhuang, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141B01_SHIJIAZHUANG")
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141B01_cargo_subtype, cargo_subtype) {
    0: return string(STR_SHIJIAZHUANG);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141B01_cargo_graphics, cargo_subtype) {
    0: spriteset_DD6141B01_shijiazhuang;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141B01_graphics, position_in_articulated_veh) {
    0: switch_DD6141B01_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141B01_articulated_part, extra_callback_info1) {
    1 : return DD6141B01;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, DD6141B01) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_DD6141B01);
        introduction_date:              date(2011,7,13);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              8;

        power:                          235 kW;
        weight:                         15 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          80 km/h;

        cargo_capacity:                 62;
        loading_speed:                  60 << param_loading_speed;
        cargo_age_period:               146 << param_cargo_decay;
    }
    graphics {
        default:                        switch_DD6141B01_graphics;
        purchase:                       spriteset_DD6141B01_purchase;
        cargo_subtype_text:             switch_DD6141B01_cargo_subtype;
        length:                         switch_8_4_length_12;
        articulated_part:               switch_DD6141B01_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_EXTRA_LARGE), string(STR_COMFORT, 146 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 60), string(STR_POWERTRAIN_TYPE, string(STR_NG)));

        cost_factor:                    281;
        running_cost_factor:            16 * runningcostfactor();
        purchase_running_cost_factor:   16 * 8;
    }
}

// End DD6141B01