// Begin DD6141S02_HIGH_SPEC

spriteset (spriteset_DD6141S02_high_spec_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Three-Axle", "DD6141S02_WHITE")
}

spriteset (spriteset_DD6141S02_high_spec_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S02_AC_WHITE")
}

spriteset (spriteset_DD6141S02_high_spec_BJ, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S02_AC_BJ")
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S02_high_spec_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_BJ_2);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S02_high_spec_cargo_graphics, cargo_subtype) {
    0: spriteset_DD6141S02_high_spec_white;
    1: spriteset_DD6141S02_high_spec_BJ;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S02_high_spec_graphics, position_in_articulated_veh) {
    0: switch_DD6141S02_high_spec_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S02_high_spec_articulated_part, extra_callback_info1) {
    1 : return DD6141S02_high_spec;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, DD6141S02_high_spec) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        variant_group:                  DD6141S02_standard;

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_DD6141S02_HIGH_SPEC);
        introduction_date:              date(2007,7,21);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              8;

        power:                          177 kW;
        weight:                         15 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          80 km/h;

        cargo_capacity:                 65;
        loading_speed:                  60 << param_loading_speed;
        cargo_age_period:               157 << param_cargo_decay;
    }
    graphics {
        default:                        switch_DD6141S02_high_spec_graphics;
        purchase:                       spriteset_DD6141S02_high_spec_purchase;
        cargo_subtype_text:             switch_DD6141S02_high_spec_cargo_subtype;
        length:                         switch_8_4_length_12;
        articulated_part:               switch_DD6141S02_high_spec_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_EXTRA_LARGE), string(STR_COMFORT, 157 ,string(STR_CLASS_HIGH_2)), string(STR_LOADING_SPEED, 60), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    252;
        running_cost_factor:            20 * runningcostfactor();
        purchase_running_cost_factor:   20 * 8;
        name:                           switch_DD6141S02_standard_name;
    }
}

// End DD6141S02_HIGH_SPEC