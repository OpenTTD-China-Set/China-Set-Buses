// Begin DD6141S01

spriteset (spriteset_DD6141S01_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Three-Axle", "DD6141S01_WHITE")
}

spriteset (spriteset_DD6141S01_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S01_WHITE")
}

spriteset (spriteset_DD6141S01_BJ, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S01_BJ")
}

spriteset (spriteset_DD6141S01_chengde, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S01_CHENGDE")
}

spriteset (spriteset_DD6141S01_shijiazhuang, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Three-Axle", "DD6141S01_SHIJIAZHUANG")
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S01_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_BJ);
    2: return string(STR_CHENGDE);
    3: return string(STR_SHIJIAZHUANG);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S01_cargo_graphics, cargo_subtype) {
    0: spriteset_DD6141S01_white;
    1: spriteset_DD6141S01_BJ;
    2: spriteset_DD6141S01_chengde;
    3: spriteset_DD6141S01_shijiazhuang;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S01_graphics, position_in_articulated_veh) {
    0: switch_DD6141S01_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_DD6141S01_articulated_part, extra_callback_info1) {
    1 : return DD6141S01;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, DD6141S01) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_DD6141S01);
        introduction_date:              date(2006,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              8;

        power:                          206 kW;
        weight:                         14.55 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          80 km/h;

        cargo_capacity:                 68;
        loading_speed:                  60 << param_loading_speed;
        cargo_age_period:               122 << param_cargo_decay;
    }
    graphics {
        default:                        switch_DD6141S01_graphics;
        purchase:                       spriteset_DD6141S01_purchase;
        cargo_subtype_text:             switch_DD6141S01_cargo_subtype;
        length:                         switch_8_4_length_12;
        articulated_part:               switch_DD6141S01_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_EXTRA_LARGE), string(STR_COMFORT, 122 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 60), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    244;
        running_cost_factor:            19 * runningcostfactor();
        purchase_running_cost_factor:   19 * 8;
    }
}

// End DD6141S01