switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_106M_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_LIST_VOLVO_SUPER_OLYMPIAN);
    return CB_RESULT_NO_TEXT;
}

