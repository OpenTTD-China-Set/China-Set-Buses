}

switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_106M_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGINAL);
    1: return string(STR_KMB);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_106M_cargo_graphics, cargo_subtype) {
    0: spriteset_Volvo_Super_Olympian_106M_original;
    1: spriteset_Volvo_Super_Olympian_106M_KMB;
}

switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_106M_graphics, position_in_articulated_veh) {
    0: switch_Volvo_Super_Olympian_106M_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_106M_articulated_part, extra_callback_info1) {
    1: return Volvo_Super_Olympian_106M;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

