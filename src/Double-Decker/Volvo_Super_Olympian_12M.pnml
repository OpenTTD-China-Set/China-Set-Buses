// Begin Volvo_Super_Olympian_12M

switch (FEAT_ROADVEHS, SELF, switch_Volvo_Super_Olympian_12M_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
