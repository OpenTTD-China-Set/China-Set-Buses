// Begin HFF6110GS1

spriteset (spriteset_HFF6110GS1_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Double-Decker", "HFF6110GS1_WHITE")
}

spriteset (spriteset_HFF6110GS1_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Double-Decker", "HFF6110GS1_WHITE")
}

spriteset (spriteset_HFF6110GS1_BJ, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Double-Decker", "HFF6110GS1_BJ")
}

spriteset (spriteset_HFF6110GS1_BJ_OLYMPIC, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Double-Decker", "HFF6110GS1_BJ_OLYMPIC")
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6110GS1_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_BJ_3);
    2: return string(STR_BJ_2008_OLYMPIC);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6110GS1_cargo_graphics, cargo_subtype) {
    0: spriteset_HFF6110GS1_white;
    1: spriteset_HFF6110GS1_BJ;
    2: spriteset_HFF6110GS1_BJ_OLYMPIC;
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6110GS1_graphics, position_in_articulated_veh) {
    0: switch_HFF6110GS1_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6110GS1_articulated_part, extra_callback_info1) {
    1 : return HFF6110GS1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, HFF6110GS1) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_HFF6110GS1);
        introduction_date:              date(2008,3,17);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              8;

        power:                          250 kW;
        weight:                         12 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          100 km/h;

        cargo_capacity:                 37;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               179 << param_cargo_decay;
    }
    graphics {
        default:                        switch_HFF6110GS1_graphics;
        purchase:                       spriteset_HFF6110GS1_purchase;
        cargo_subtype_text:             switch_HFF6110GS1_cargo_subtype;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_HFF6110GS1_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 179 ,string(STR_CLASS_HIGH_2)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    262;
        running_cost_factor:            21 * runningcostfactor();
        purchase_running_cost_factor:   21 * 8;
    }
}

// End HFF6110GS1