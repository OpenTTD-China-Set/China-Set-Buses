// Begin KLQ6119GS

switch (FEAT_ROADVEHS, SELF, switch_KLQ6119GS_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_LIST_HIGER_9_BUS);
    return CB_RESULT_NO_TEXT;
}

spriteset (spriteset_KLQ6119GS_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Double-Decker", "KLQ6119GS_WHITE")
}

spriteset (spriteset_KLQ6119GS_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Double-Decker", "KLQ6119GS_WHITE")
}

spriteset (spriteset_KLQ6119GS_tj, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Double-Decker", "KLQ6119GS_TJ")
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6119GS_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_TJ_SILVER);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6119GS_cargo_graphics, cargo_subtype) {
    0: spriteset_KLQ6119GS_white;
    1: spriteset_KLQ6119GS_tj;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6119GS_graphics, position_in_articulated_veh) {
    0: switch_KLQ6119GS_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6119GS_articulated_part, extra_callback_info1) {
    1 : return KLQ6119GS;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, KLQ6119GS) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        variant_group:					KLQ6109G;
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_KLQ6119GS);
        introduction_date:              date(2010,4,11);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              12;

        power:                          206 kW;
        weight:                         12.28 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          75 km/h;

        cargo_capacity:                 44;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               168 << param_cargo_decay;
    }
    graphics {
        default:                        switch_KLQ6119GS_graphics;
        purchase:                       spriteset_KLQ6119GS_purchase;
        cargo_subtype_text:             switch_KLQ6119GS_cargo_subtype;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_KLQ6119GS_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 168 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    247;
        running_cost_factor:            17 * runningcostfactor();
        purchase_running_cost_factor:   17 * 8;
        name:                           switch_KLQ6119GS_name;
    }
}

// End KLQ6119GS