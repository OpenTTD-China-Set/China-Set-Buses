// Begin HFF6120GD

spriteset (spriteset_HFF6120GD_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "HFF6120GD_WHITE")
}

spriteset (spriteset_HFF6120GD_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "HFF6120GD_WHITE")
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6120GD_graphics, position_in_articulated_veh) {
    0: spriteset_HFF6120GD_white;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_HFF6120GD_articulated_part, extra_callback_info1) {
    1 : return HFF6120GD;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, HFF6120GD) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_HFF6120GD);
        introduction_date:              date(1994,3,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          290 hp;
        weight:                         12.5 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          120 km/h;

        cargo_capacity:                 25;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               273 << param_cargo_decay;
    }
    graphics {
        default:                        switch_HFF6120GD_graphics;
        purchase:                       spriteset_HFF6120GD_purchase;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_HFF6120GD_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_LONG_DISTANCE), string(STR_SIZE_LARGE), string(STR_COMFORT, 273 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    231;
        running_cost_factor:            25 * runningcostfactor();
        purchase_running_cost_factor:   25 * 8;
    }
}

// End HFF6120GD