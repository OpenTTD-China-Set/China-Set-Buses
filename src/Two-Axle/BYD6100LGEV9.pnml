// Begin BYD6100LGEV9

spriteset (spriteset_BYD6100LGEV9_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "BYD6100LGEV9_WHITE")
}

spriteset (spriteset_BYD6100LGEV9_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "BYD6100LGEV9_WHITE")
}

switch (FEAT_ROADVEHS, SELF, switch_BYD6100LGEV9_graphics, position_in_articulated_veh) {
    0: spriteset_BYD6100LGEV9_white;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_BYD6100LGEV9_articulated_part, extra_callback_info1) {
    1: return BYD6100LGEV9;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


item (FEAT_ROADVEHS, BYD6100LGEV9) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_BYD6100LGEV9);
        introduction_date:              date(2018,8,2);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              8;

        power:                          100 kW;
        weight:                         12.2 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          70 km/h;

        cargo_capacity:                 43;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               160 << param_cargo_decay;
    }
    graphics {
        default:                        switch_BYD6100LGEV9_graphics;
        purchase:                       spriteset_BYD6100LGEV9_purchase;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_BYD6100LGEV9_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 160 ,string(STR_CLASS_HIGH_2)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_ELECTRIC)));

        cost_factor:                    358;
        running_cost_factor:            5 * runningcostfactor();
        purchase_running_cost_factor:   5 * 8;
    }
}

// End BYD6100LGEV9