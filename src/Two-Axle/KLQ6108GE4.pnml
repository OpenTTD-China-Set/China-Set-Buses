// Begin KLQ6108GE4

spriteset (spriteset_KLQ6108GE4_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "KLQ6108GE4_WHITE")
}

spriteset (spriteset_KLQ6108GE4_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KLQ6108GE4_WHITE")
}

spriteset (spriteset_KLQ6108GE4_tjbh, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KLQ6108GE4_TJBH")
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6108GE4_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_TJBH);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6108GE4_cargo_graphics, cargo_subtype) {
    0: spriteset_KLQ6108GE4_white;
    1: spriteset_KLQ6108GE4_tjbh;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6108GE4_graphics, position_in_articulated_veh) {
    0: switch_KLQ6108GE4_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6108GE4_articulated_part, extra_callback_info1) {
    1 : return KLQ6108GE4;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, KLQ6108GE4) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_KLQ6108GE4);
        introduction_date:              date(2009,4,2);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              12;

        power:                          180 kW;
        weight:                         10.6 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          85 km/h;

        cargo_capacity:                 38;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               134 << param_cargo_decay;
    }
    graphics {
        default:                        switch_KLQ6108GE4_graphics;
        purchase:                       spriteset_KLQ6108GE4_purchase;
        cargo_subtype_text:             switch_KLQ6108GE4_cargo_subtype;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_KLQ6108GE4_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 134 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    204;
        running_cost_factor:            17 * runningcostfactor();
        purchase_running_cost_factor:   17 * 8;
    }
}

// End KLQ6108GE4