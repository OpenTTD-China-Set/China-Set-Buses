// Begin RC421P

spriteset (spriteset_RC421P_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "RC421P_HB")
}

spriteset (spriteset_RC421P_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "RC421P_HB")
}

switch (FEAT_ROADVEHS, SELF, switch_RC421P_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGINAL);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_RC421P_cargo_graphics, cargo_subtype) {
    0: spriteset_RC421P_original;
}

switch (FEAT_ROADVEHS, SELF, switch_RC421P_graphics, position_in_articulated_veh) {
    0: switch_RC421P_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_RC421P_articulated_part, extra_callback_info1) {
    1 : return RC421P;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, RC421P) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         8;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_RC421P);
        introduction_date:              date(1977,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          158 kW;
        weight:                         8.8 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          100 km/h;

        cargo_capacity:                 23 ;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               263 << param_cargo_decay;
    }
    graphics {
        default:                        switch_RC421P_graphics;
        purchase:                       spriteset_RC421P_purchase;
        cargo_subtype_text:             switch_RC421P_cargo_subtype;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_RC421P_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_LONG_DISTANCE), string(STR_SIZE_LARGE), string(STR_COMFORT, 263 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));
        cost_factor:                    176;
        running_cost_factor:            18 * runningcostfactor();
        purchase_running_cost_factor:   18 * 8;
    }
}

// End RC421P