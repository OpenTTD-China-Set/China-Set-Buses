//Begin JNP6127FEA_60seats

spriteset (spriteset_JNP6127FEA_60seats_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "JNP6127FEA_ORIGINAL")
}

spriteset (spriteset_JNP6127FEA_60seats_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "JNP6127FEA_ORIGINAL")
}

switch (FEAT_ROADVEHS, SELF, switch_JNP6127FEA_60seats_graphics, position_in_articulated_veh) {
    0: spriteset_JNP6127FEA_60seats_original;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_JNP6127FEA_60seats_articulated_part, extra_callback_info1) {
    1 : return JNP6127FEA_60seats;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, JNP6127FEA_60seats) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        variant_group:					JNP6127FEA_38seats;

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_JNP6127FEA_60SEATS);
        introduction_date:              date(2010,1,23);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              4;

        power:                          276 kW;
        weight:                         13.24 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          125 km/h;

        cargo_capacity:                 30;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               224 << param_cargo_decay;
    }
    graphics {
        default:                        switch_JNP6127FEA_60seats_graphics;
        purchase:                       spriteset_JNP6127FEA_60seats_purchase;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_JNP6127FEA_60seats_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_INTERCITY_COACH), string(STR_SIZE_LARGE), string(STR_COMFORT, 224 ,string(STR_CLASS_MEDIUM)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    280;
        running_cost_factor:            27 * runningcostfactor();
        purchase_running_cost_factor:   27 * 8;
        name:                           switch_JNP6127FEA_38seats_name;
    }
}

