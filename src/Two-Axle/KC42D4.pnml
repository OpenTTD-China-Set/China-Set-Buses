// Begin KC42D4

switch (FEAT_ROADVEHS, SELF, switch_KC42D4_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_LIST_NISSAN_ECHO);
    return CB_RESULT_NO_TEXT;
}

spriteset (spriteset_KC42D4_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "KC42D4_WHITE")
}

spriteset (spriteset_KC42D4_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KC42D4_WHITE")
}

spriteset (spriteset_KC42D4_bumper_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KC42D4_BUMPER_WHITE")
}

spriteset (spriteset_KC42D4_red, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KC42D4_RED")
}

spriteset (spriteset_KC42D4_bumper_red, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KC42D4_BUMPER_RED")
}

spriteset (spriteset_KC42D4_green, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KC42D4_GREEN")
}

switch (FEAT_ROADVEHS, SELF, switch_KC42D4_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_BUMPER_WHITE);
    2: return string(STR_HK_RED);
    3: return string(STR_HK_BUMPER_RED);
    4: return string(STR_HK_GREEN);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_KC42D4_graphics, cargo_subtype) {
    0: spriteset_KC42D4_white;
    1: spriteset_KC42D4_bumper_white;
    2: spriteset_KC42D4_red;
    3: spriteset_KC42D4_bumper_red;
    4: spriteset_KC42D4_green;
}

item (FEAT_ROADVEHS, KC42D4) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         5;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_KC42D4);
        introduction_date:              date(1966,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   22;
        reliability_decay:              12;

        power:                          48 kW;
        weight:                         1.65 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          90 km/h;

        cargo_capacity:                 14;
        loading_speed:                  10 << param_loading_speed;
        cargo_age_period:               134 << param_cargo_decay;
    }
    graphics {
        default:                        switch_KC42D4_graphics;
        purchase:                       spriteset_KC42D4_purchase;
        cargo_subtype_text:             switch_KC42D4_cargo_subtype;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_MINI), string(STR_COMFORT, 134 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 10), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    52;
        running_cost_factor:            11 * runningcostfactor();
        purchase_running_cost_factor:   11 * 8;
        name:                           switch_KC42D4_name;
    }
}

// End KC42D4