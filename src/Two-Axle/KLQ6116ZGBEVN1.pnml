spriteset (spriteset_KLQ6116ZGBEVN1_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "KLQ6116ZGBEVN1_ORIGINAL")
}

spriteset (spriteset_KLQ6116ZGBEVN1_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KLQ6116ZGBEVN1_ORIGINAL")
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6116ZGBEVN1_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGINAL);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6116ZGBEVN1_cargo_graphics, cargo_subtype) {
    0: spriteset_KLQ6116ZGBEVN1_original;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6116ZGBEVN1_graphics, position_in_articulated_veh) {
    0: switch_KLQ6116ZGBEVN1_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6116ZGBEVN1_articulated_part, extra_callback_info1) {
    1 : return KLQ6116ZGBEVN1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

