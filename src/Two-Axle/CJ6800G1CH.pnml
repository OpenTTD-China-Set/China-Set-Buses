// Begin CJ6800G1CHG1CH

spriteset (spriteset_CJ6800G1CH_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "CJ6800G1CH")
}

spriteset (spriteset_CJ6800G1CH_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "CJ6800G1CH")
}

switch (FEAT_ROADVEHS, SELF, switch_CJ6800G1CH_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_CJ6800G1CH_graphics, cargo_subtype) {
    0: spriteset_CJ6800G1CH_white;
}

item (FEAT_ROADVEHS, CJ6800G1CH) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         8;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_CJ6800G1CH);
        introduction_date:              date(2002,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              16;

        power:                          99 kW;
        weight:                         6.38 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          80 km/h;

        cargo_capacity:                 53;
        loading_speed:                  30 << param_loading_speed;
        cargo_age_period:               110 << param_cargo_decay;
    }
    graphics {
        default:                        switch_CJ6800G1CH_graphics;
        purchase:                       spriteset_CJ6800G1CH_purchase;
        cargo_subtype_text:             switch_CJ6800G1CH_cargo_subtype;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_MEDIUM), string(STR_COMFORT, 110 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 30), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    130;
        running_cost_factor:            13 * runningcostfactor();
        purchase_running_cost_factor:   13 * 8;
    }
}

// End CJ6800G1CH