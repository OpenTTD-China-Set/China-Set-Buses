//Begin YBL6125H1QCJ

spriteset (spriteset_YBL6125H1QCJ_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "YBL6125H1QCJ_WHITE")
}

spriteset (spriteset_YBL6125H1QCJ_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "YBL6125H1QCJ_WHITE")
}

switch (FEAT_ROADVEHS, SELF, switch_YBL6125H1QCJ_graphics, position_in_articulated_veh) {
    0: spriteset_YBL6125H1QCJ_white;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_YBL6125H1QCJ_articulated_part, extra_callback_info1) {
    1 : return YBL6125H1QCJ;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, YBL6125H1QCJ) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_YBL6125H1QCJ);
        introduction_date:              date(2013,6,24);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          247 kW;
        weight:                         13.36 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          100 km/h;

        cargo_capacity:                 27;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               226 << param_cargo_decay;
    }
    graphics {
        default:                        switch_YBL6125H1QCJ_graphics;
        purchase:                       spriteset_YBL6125H1QCJ_purchase;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_YBL6125H1QCJ_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_LONG_DISTANCE), string(STR_SIZE_LARGE), string(STR_COMFORT, 226 ,string(STR_CLASS_MEDIUM)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_NG)));

        cost_factor:                    269;
        running_cost_factor:            18 * runningcostfactor();
        purchase_running_cost_factor:   18 * 8;
    }
}

