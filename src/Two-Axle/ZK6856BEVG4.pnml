switch (FEAT_ROADVEHS, SELF, switch_ZK6856BEVG4_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_LIST_YUTONG_E8);
    return CB_RESULT_NO_TEXT;
}

spriteset (spriteset_ZK6856BEVG4_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "ZK6856BEVG4_WHITE")
}

spriteset (spriteset_ZK6856BEVG4_white, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
