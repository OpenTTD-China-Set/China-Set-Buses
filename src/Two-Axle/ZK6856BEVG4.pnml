}

spriteset (spriteset_ZK6856BEVG4_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "ZK6856BEVG4_ORIGINAL")
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6856BEVG4_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE);
    1: return string(STR_ORIGINAL);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6856BEVG4_graphics, cargo_subtype) {
    0: spriteset_ZK6856BEVG4_white;
    1: spriteset_ZK6856BEVG4_original;
}

