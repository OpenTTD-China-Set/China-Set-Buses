        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_SWB6120KHV_3);
        introduction_date:              date(2001,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   13;
        reliability_decay:              12;

        power:                          169 kW;
        weight:                         11.0 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          78 km/h;

        cargo_capacity:                 44;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               154 << param_cargo_decay;
    }
    graphics {
        default:                        switch_SWB6120KHV_3_graphics;
        purchase:                       spriteset_SWB6120KHV_3_purchase;
        cargo_subtype_text:             switch_SWB6120KHV_3_cargo_subtype;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_SWB6120KHV_3_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 154 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    219;
        running_cost_factor:            16 * runningcostfactor();
        purchase_running_cost_factor:   16 * 8;
        name:                           switch_shenhao_name;
    }
}

