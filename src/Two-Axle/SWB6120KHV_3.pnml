// Begin SWB6120KHV_3
switch (FEAT_ROADVEHS, SELF, switch_shenhao_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_LIST_SHENHAO);
    return CB_RESULT_NO_TEXT;
}

spriteset (spriteset_SWB6120KHV_3_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "SWB6120KHV_3_SH_GREEN")
}

spriteset (spriteset_SWB6120KHV_3_green, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "SWB6120KHV_3_SH_GREEN")
}

switch (FEAT_ROADVEHS, SELF, switch_SWB6120KHV_3_cargo_subtype, cargo_subtype) {
    0: return string(STR_SH_GREEN);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_SWB6120KHV_3_cargo_graphics, cargo_subtype) {
    0: spriteset_SWB6120KHV_3_green;
}

switch (FEAT_ROADVEHS, SELF, switch_SWB6120KHV_3_graphics, position_in_articulated_veh) {
    0: switch_SWB6120KHV_3_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_SWB6120KHV_3_articulated_part, extra_callback_info1) {
    1 : return SWB6120KHV_3;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, SWB6120KHV_3) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
