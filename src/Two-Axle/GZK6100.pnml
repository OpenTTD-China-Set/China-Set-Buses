// Begin GZK6100

spriteset (spriteset_GZK6100_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "GZK6100_ORIGINAL")
}

spriteset (spriteset_GZK6100_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "GZK6100_ORIGINAL")
}

spriteset (spriteset_GZK6100_original_high_roof, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "GZK6100_ORIGINAL_HIGH_ROOF")
}

switch (FEAT_ROADVEHS, SELF, switch_GZK6100_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGINAL);
    1: return string(STR_ORIGINAL_HIGH_ROOF);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_GZK6100_cargo_graphics, cargo_subtype) {
    0: spriteset_GZK6100_original;
    1: spriteset_GZK6100_original_high_roof;
}

switch (FEAT_ROADVEHS, SELF, switch_GZK6100_graphics, position_in_articulated_veh) {
    0: switch_GZK6100_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_GZK6100_articulated_part, extra_callback_info1) {
    1: return GZK6100;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, GZK6100) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_GZK6100);
        introduction_date:              date(1993,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              16;

        power:                          118 kW;
        weight:                         8.5 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          90 km/h;

        cargo_capacity:                 33;
        loading_speed:                  30 << param_loading_speed;
        cargo_age_period:               109 << param_cargo_decay;
    }
    graphics {
        default:                        switch_GZK6100_graphics;
        purchase:                       spriteset_GZK6100_purchase;
        cargo_subtype_text:             switch_GZK6100_cargo_subtype;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_GZK6100_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 109 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 30), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));

        cost_factor:                    145;
        running_cost_factor:            16 * runningcostfactor();
        purchase_running_cost_factor:   16 * 8;
    }
}

// End GZK6100