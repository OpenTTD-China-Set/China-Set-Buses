switch (FEAT_ROADVEHS, SELF, switch_ZK6117BEVY33_graphics, position_in_articulated_veh) {
    0: switch_ZK6117BEVY33_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6117BEVY33_articulated_part, extra_callback_info1) {
