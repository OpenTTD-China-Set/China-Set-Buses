// Begin KLQ6115HTAE50

spriteset (spriteset_KLQ6115HTAE50_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "KLQ6115HTAE50_ORIGINAL")
}

spriteset (spriteset_KLQ6115HTAE50_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "KLQ6115HTAE50_ORIGINAL")
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6115HTAE50_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGINAL);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6115HTAE50_cargo_graphics, cargo_subtype) {
    0: spriteset_KLQ6115HTAE50_original;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6115HTAE50_graphics, position_in_articulated_veh) {
    0: switch_KLQ6115HTAE50_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_KLQ6115HTAE50_articulated_part, extra_callback_info1) {
    1 : return KLQ6115HTAE50;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, KLQ6115HTAE50) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         8;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_KLQ6115HTAE50);
        introduction_date:              date(2020,2,13);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          239 kW;
        weight:                         11.4 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          100 km/h;

        cargo_capacity:                 24 ;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               285 << param_cargo_decay;
    }
    graphics {
        default:                        switch_KLQ6115HTAE50_graphics;
        purchase:                       spriteset_KLQ6115HTAE50_purchase;
        cargo_subtype_text:             switch_KLQ6115HTAE50_cargo_subtype;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_KLQ6115HTAE50_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_LONG_DISTANCE), string(STR_SIZE_LARGE), string(STR_COMFORT, 285 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));
        cost_factor:                    262;
        running_cost_factor:            20 * runningcostfactor();
        purchase_running_cost_factor:   20 * 8;
    }
}

// End KLQ6115HTAE50