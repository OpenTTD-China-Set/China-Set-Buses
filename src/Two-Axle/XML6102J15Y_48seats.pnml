// Begin XML6102J15Y_48seats

spriteset (spriteset_XML6102J15Y_48seats_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "XML6102J15Y")
}

spriteset (spriteset_XML6102J15Y_48seats_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "XML6102J15Y")
}

switch (FEAT_ROADVEHS, SELF, switch_XML6102J15Y_48seats_graphics, position_in_articulated_veh) {
    0: spriteset_XML6102J15Y_48seats_original;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_XML6102J15Y_48seats_articulated_part, extra_callback_info1) {
    1 : return XML6102J15Y_48seats;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, XML6102J15Y_48seats) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        variant_group:					XML6102J15Y_36seats;

        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         8;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_XML6102J15Y_48SEATS);
        introduction_date:              date(2015,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          180 kW;
        weight:                         10.9 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          100 km/h;

        cargo_capacity:                 24 ;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               226 << param_cargo_decay;
    }
    graphics {
        default:                        switch_XML6102J15Y_48seats_graphics;
        purchase:                       spriteset_XML6102J15Y_48seats_purchase;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_XML6102J15Y_48seats_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_INTERCITY_COACH), string(STR_SIZE_LARGE), string(STR_COMFORT, 226 ,string(STR_CLASS_MEDIUM)), string(STR_LOADING_SPEED, 20), string(STR_POWERTRAIN_TYPE, string(STR_DIESEL)));
        cost_factor:                    228;
        running_cost_factor:            20 * runningcostfactor();
        purchase_running_cost_factor:   20 * 8;
        name:                           switch_XML6102J15Y_36seats_name;
    }
}

