switch (FEAT_ROADVEHS, SELF, switch_ZK6128H6QY1_50seats_cargo_subtype, cargo_subtype) {
    0: return string(STR_WHITE_6_1_WINDSHIELD);
    1: return string(STR_ORIGINAL_6_1_WINDSHIELD);
    2: return string(STR_WHITE_6_2_WINDSHIELD);
    3: return string(STR_ORIGINAL_6_2_WINDSHIELD);
    4: return string(STR_WHITE_7_1_WINDSHIELD);
    5: return string(STR_ORIGINAL_7_1_WINDSHIELD);
    6: return string(STR_WHITE_7_2_WINDSHIELD);
    7: return string(STR_ORIGINAL_7_2_WINDSHIELD);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6128H6QY1_50seats_cargo_graphics, cargo_subtype) {
    0: spriteset_ZK6128H6QY1_50seats_white_6_1;
    1: spriteset_ZK6128H6QY1_50seats_original_6_1;
    2: spriteset_ZK6128H6QY1_50seats_white_6_2;
    3: spriteset_ZK6128H6QY1_50seats_original_6_2;
    4: spriteset_ZK6128H6QY1_50seats_white_7_1;
    5: spriteset_ZK6128H6QY1_50seats_original_7_1;
    6: spriteset_ZK6128H6QY1_50seats_white_7_2;
    7: spriteset_ZK6128H6QY1_50seats_original_7_2;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6128H6QY1_50seats_graphics, position_in_articulated_veh) {
    0: switch_ZK6128H6QY1_50seats_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_ZK6128H6QY1_50seats_articulated_part, extra_callback_info1) {
    1 : return ZK6128H6QY1_50seats;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

