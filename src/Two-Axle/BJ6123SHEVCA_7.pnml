// Begin BJ6123SHEVCA_7

spriteset (spriteset_BJ6123SHEVCA_7_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "BJ6123SHEVCA_7_BJ_BDL")
}

spriteset (spriteset_BJ6123SHEVCA_7_bdl, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "BJ6123SHEVCA_7_BJ_BDL")
}

spriteset (spriteset_BJ6123SHEVCA_7_blc, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "BJ6123SHEVCA_7_BJ_BLC")
}

switch (FEAT_ROADVEHS, SELF, switch_BJ6123SHEVCA_7_cargo_subtype, cargo_subtype) {
    0: return string(STR_BJ_BEIDIANLAN);
    1: return string(STR_BJ_BLUE_LUCKY_CLOUDS);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_ROADVEHS, SELF, switch_BJ6123SHEVCA_7_cargo_graphics, cargo_subtype) {
    0: spriteset_BJ6123SHEVCA_7_bdl;
    1: spriteset_BJ6123SHEVCA_7_blc;
}

switch (FEAT_ROADVEHS, SELF, switch_BJ6123SHEVCA_7_graphics, position_in_articulated_veh) {
    0: switch_BJ6123SHEVCA_7_cargo_graphics;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_BJ6123SHEVCA_7_articulated_part, extra_callback_info1) {
    1 : return BJ6123SHEVCA_7;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, BJ6123SHEVCA_7) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         7;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_BJ6123SHEVCA_7);
        introduction_date:              date(2019,10,15);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   13;
        reliability_decay:              12;

        power:                          103 kW;
        weight:                         12.7 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          70 km/h;

        cargo_capacity:                 40;
        loading_speed:                  40 << param_loading_speed;
        cargo_age_period:               160 << param_cargo_decay;
    }
    graphics {
        default:                        switch_BJ6123SHEVCA_7_graphics;
        purchase:                       spriteset_BJ6123SHEVCA_7_purchase;
        cargo_subtype_text:             switch_BJ6123SHEVCA_7_cargo_subtype;
        length:                         switch_8_3_length_11;
        articulated_part:               switch_BJ6123SHEVCA_7_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_URBAN), string(STR_SIZE_LARGE), string(STR_COMFORT, 160 ,string(STR_CLASS_HIGH_1)), string(STR_LOADING_SPEED, 40), string(STR_POWERTRAIN_TYPE, string(STR_HYBRID_2, string(STR_ELECTRIC), string(STR_NG))));

        cost_factor:                    291;
        running_cost_factor:            9 * runningcostfactor();
        purchase_running_cost_factor:   9 * 8;
    }
}

