// Begin JT6970W

spriteset (spriteset_JT6970W_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase_32bpp ("Two-Axle", "JT6970W_ORIGINAL")
}

spriteset (spriteset_JT6970W_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard_0 ("Two-Axle", "JT6970W_ORIGINAL")
}

switch (FEAT_ROADVEHS, SELF, switch_JT6970W_graphics, position_in_articulated_veh) {
    0: spriteset_JT6970W_original;
    empty_sprites;
}

switch (FEAT_ROADVEHS, SELF, switch_JT6970W_articulated_part, extra_callback_info1) {
    1 : return JT6970W;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_ROADVEHS, JT6970W) {
    property {
        sprite_id:                      SPRITE_ID_NEW_ROADVEH;
        climates_available:             ALL_CLIMATES;
        running_cost_base:              RUNNING_COST_ROADVEH;
        refit_cost:                     0;
        misc_flags:                     bitmask(ROADVEH_FLAG_AUTOREFIT);
        cost_factor:                    1;
        running_cost_factor:            1;

        length:                         8;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        default_cargo_type:             PASS;

        name:                           string(STR_NAME_JT6970W);
        introduction_date:              date(1992,1,1);
        model_life:                     60;
        retire_early:                   50;
        vehicle_life:                   15;
        reliability_decay:              8;

        power:                          99 kW;
        weight:                         8.65 ton;
        tractive_effort_coefficient:    0.3;
        speed:                          85 km/h;

        cargo_capacity:                 13 ;
        loading_speed:                  10 << param_loading_speed;
        cargo_age_period:               248 << param_cargo_decay;
    }
    graphics {
        default:                        switch_JT6970W_graphics;
        purchase:                       spriteset_JT6970W_purchase;
        length:                         switch_8_2_length_10;
        articulated_part:               switch_JT6970W_articulated_part;
        additional_text:                string(STR_DESC_5, string(STR_TYPE_LONG_DISTANCE), string(STR_SIZE_LARGE), string(STR_COMFORT, 248 ,string(STR_CLASS_ORDINARY)), string(STR_LOADING_SPEED, 10), string(STR_POWERTRAIN_TYPE, string(STR_PETROL)));
        cost_factor:                    135;
        running_cost_factor:            15 * runningcostfactor();
        purchase_running_cost_factor:   15 * 8;
    }
}

// End JT6970W